{
  "response_contract": "response-contract-v2",
  "scenario_contract": "1.0-gate-a-dev",
  "status": "frozen",
  "purpose": "Frozen public semantic assertion contract. It exposes ontology and field names, not expected values.",
  "envelope": {
    "required": ["response_contract", "scenario_id", "checkpoint", "queries"],
    "query_value_required": ["assertions"],
    "query_ids_are_public": true
  },
  "assertion": {
    "required": ["subject", "predicate", "knowledge_status", "source_refs"],
    "optional": ["value", "unknown_reason", "confirmation_ref"],
    "forbidden": ["state_key"],
    "subject": "non-empty public entity, task, action, capture, or scenario identifier; use the listed public ID when possible",
    "predicate": "non-empty public ontology predicate; use the listed canonical ID when possible",
    "known_and_inferred": "must include value",
    "unknown": "must omit value and include unknown_reason",
    "source_refs": "unique public event_id strings from the received captures"
  },
  "knowledge_status": ["known", "inferred", "unknown"],
  "unknown_reason": {
    "allowed_categories": [
      "ambiguous_person",
      "conflicting",
      "unreadable",
      "not_available",
      "no_capture_for_period",
      "no_consumption_observation",
      "not_stated",
      "missing"
    ],
    "natural_language": "A concise natural-language reason is accepted and deterministically mapped to one of the categories when a listed phrase is present. Otherwise the normalized reason is compared literally."
  },
  "public_ontology": {
    "subjects": [
      {"id": "streamly", "kind": "subscription", "aliases": ["Streamly", "Streamly subscription"]},
      {"id": "orange_mobile", "kind": "service", "aliases": ["Orange Mobile", "Orange bill", "Orange"]},
      {"id": "marketone", "kind": "merchant", "aliases": ["MarketOne", "Market One", "protein bars"]},
      {"id": "parcel_pickup_1", "kind": "task", "aliases": ["parcel pickup", "original parcel pickup", "first parcel pickup"]},
      {"id": "parcel_pickup_2", "kind": "task", "aliases": ["replacement parcel", "replacement parcel pickup", "second parcel pickup"]},
      {"id": "library_return_1", "kind": "task", "aliases": ["library return", "library books", "return library books"]},
      {"id": "school_form_1", "kind": "task", "aliases": ["school form", "school form submission"]},
      {"id": "streamly_cancellation_task", "kind": "task", "aliases": ["cancel Streamly", "Streamly cancellation"]},
      {"id": "roadsure", "kind": "insurance", "aliases": ["RoadSure", "RoadSure policy", "car insurance"]},
      {"id": "gymflex", "kind": "contract", "aliases": ["GymFlex", "GymFlex contract"]},
      {"id": "homefix", "kind": "observation", "aliases": ["HomeFix", "HomeFix quote", "HomeFix appointment"]},
      {"id": "bank_standing_order", "kind": "action", "aliases": ["bank standing order", "standing order"]},
      {"id": "transfer_sam", "kind": "action", "aliases": ["transfer to Sam", "Sam transfer", "transfer Sam"]},
      {"id": "jordan", "kind": "person_reference", "aliases": ["Jordan", "unqualified Jordan"]},
      {"id": "jordan_lee", "kind": "person", "aliases": ["Jordan Lee"]},
      {"id": "jordan_kim", "kind": "person", "aliases": ["Jordan Kim"]},
      {"id": "alex", "kind": "person", "aliases": ["Alex"]},
      {"id": "sam", "kind": "person", "aliases": ["Sam"]},
      {"id": "scenario", "kind": "aggregate", "aliases": ["scenario", "timeline", "overall history"]}
    ],
    "dynamic_subjects": [
      {"pattern": "capture:<event_id>", "kind": "capture", "aliases": ["<event_id>"]}
    ],
    "predicates": [
      {"id": "billing_period", "aliases": ["billing period", "recurrence", "monthly", "per month"]},
      {"id": "cancellation_intent", "aliases": ["cancellation intent", "cancel intention", "intention to cancel"]},
      {"id": "cancellation_requested", "aliases": ["cancellation requested", "cancel request"]},
      {"id": "currency", "aliases": ["currency", "currency code"]},
      {"id": "current_price", "aliases": ["current price", "current cost", "current monthly cost", "monthly cost"]},
      {"id": "last_charge", "aliases": ["last charge", "last directly observed charge"]},
      {"id": "status", "aliases": ["status", "current status", "current state", "lifecycle"]},
      {"id": "historical_price", "aliases": ["historical price", "price history", "previous price", "price changes"]},
      {"id": "termination_date", "aliases": ["termination date", "cancellation date"]},
      {"id": "price_effective", "aliases": ["price effective", "price effective date", "price change effective date"]},
      {"id": "next_renewal", "aliases": ["next renewal", "renewal date"]},
      {"id": "needs_attention", "aliases": ["needs attention", "attention", "requires attention", "open deadline"]},
      {"id": "effective_date", "aliases": ["effective date", "effective from"]},
      {"id": "expiry_date", "aliases": ["expiry date", "expiration date", "expires"]},
      {"id": "policy_id", "aliases": ["policy id", "policy number"]},
      {"id": "premium", "aliases": ["premium", "insurance premium"]},
      {"id": "beneficiary", "aliases": ["beneficiary"]},
      {"id": "claim_number", "aliases": ["claim number"]},
      {"id": "observed_bill_count", "aliases": ["observed bill count", "number of observed bills"]},
      {"id": "observed_total", "aliases": ["observed total", "observed spending total", "sum of observed bills"]},
      {"id": "observed_periods", "aliases": ["observed periods", "billed periods"]},
      {"id": "missing_periods", "aliases": ["missing periods", "periods with no bill"]},
      {"id": "unobserved_periods", "aliases": ["unobserved periods", "unknown bill periods"]},
      {"id": "current_amount", "aliases": ["current amount", "current amount due"]},
      {"id": "purchase_count", "aliases": ["purchase count", "number of purchases"]},
      {"id": "purchased_total", "aliases": ["purchased total", "purchase total", "purchase spending total"]},
      {"id": "confirmed_consumption_quantity", "aliases": ["confirmed consumption quantity", "consumed quantity"]},
      {"id": "consumption_observation_count", "aliases": ["consumption observation count", "number of consumption observations"]},
      {"id": "explicit_zero_is_supported", "aliases": ["explicit zero is supported", "explicit zero"]},
      {"id": "unobserved_consumption", "aliases": ["unobserved consumption", "missing consumption observations"]},
      {"id": "deadline", "aliases": ["deadline", "due date", "due"]},
      {"id": "owner", "aliases": ["owner", "assignee", "responsible person"]},
      {"id": "blocker", "aliases": ["blocker", "blocking issue"]},
      {"id": "entity_link", "aliases": ["entity link", "identity link", "person link"]},
      {"id": "relationship", "aliases": ["relationship", "relation", "duplicate relation", "change relation"]},
      {"id": "duplicate_event_count", "aliases": ["duplicate event count", "duplicate capture count", "duplicate upload count"]},
      {"id": "duplicate_group_count", "aliases": ["duplicate group count", "number of duplicate groups"]},
      {"id": "meaningful_change_event_count", "aliases": ["meaningful change event count", "meaningful change count"]},
      {"id": "quoted_amount", "aliases": ["quoted amount", "quote amount"]},
      {"id": "historical_status", "aliases": ["historical status", "old status", "previous status"]},
      {"id": "approval_required", "aliases": ["approval required", "requires approval"]},
      {"id": "approved", "aliases": ["approved", "approval granted"]},
      {"id": "executed", "aliases": ["executed", "was executed"]},
      {"id": "approval_scope", "aliases": ["approval scope", "what requires approval"]},
      {"id": "amount", "aliases": ["amount", "cost", "price", "total"]}
    ]
  },
  "value_normalization": {
    "case_insensitive_enum_and_identifier_strings": true,
    "whitespace_normalization": true,
    "decimal_equivalence": "numeric values and decimal strings representing the same finite decimal are equal; currency remains a separate field",
    "date_equivalence": "ISO calendar dates with equivalent zero padding are equal",
    "order_insensitive_value_fields": ["changed_fields", "observed_periods", "missing_periods"],
    "enum_field_aliases": {
      "relation_type": {
        "exact_duplicate": ["exact duplicate"],
        "normalized_duplicate": ["normalized duplicate"],
        "meaningful_change": ["meaningful change"],
        "similar_not_duplicate": ["similar not duplicate"]
      },
      "status": {
        "not_started": ["not started"],
        "in_progress": ["in progress"],
        "needs_review": ["needs review"]
      }
    },
    "object_field_aliases": {
      "amount": ["amount_eur", "cost_eur", "price_eur", "monthly_cost_eur", "total_eur", "observed_total_eur", "latest_charged_eur", "announced_monthly_eur"],
      "currency": ["currency_code"],
      "billing_period": ["period", "recurrence"],
      "deadline": ["due_date", "due"],
      "owner": ["assignee", "responsible_person"],
      "source_event_id": ["source", "source_capture_id"],
      "target_event_id": ["target", "target_capture_id"],
      "relation_type": ["relation", "relationship"],
      "duplicate_group": ["duplicate_group_id"]
    }
  },
  "predicate_value_shapes": {
    "current_price": "object {amount, currency, billing_period}",
    "last_charge": "object {amount, currency}",
    "observed_total": "object {amount, currency}",
    "current_amount": "object {amount, currency}",
    "purchased_total": "object {amount, currency}",
    "premium": "object {amount, currency}",
    "quoted_amount": "object {amount, currency}",
    "amount": "object {amount, currency} when currency is observed; otherwise preserve the explicitly observed scalar",
    "relationship": "object {relation_type, source_event_id, target_event_id, and any explicitly supported detail fields}",
    "entity_link": "object describing the supported entity-link status and candidates",
    "needs_attention": "object {reason, plus the relevant deadline or approval/execution facts}",
    "observed_periods": "array of YYYY-MM periods",
    "missing_periods": "array of YYYY-MM periods",
    "unobserved_periods": "array of YYYY-MM periods"
  },
  "matching": {
    "primary_fields": ["subject", "predicate", "knowledge_status", "value_or_unknown_reason"],
    "provenance_fields": ["source_refs", "confirmation_ref"],
    "provenance_rule": "source_refs are required, must name available captures, and are scored as secondary provenance. Extra valid evidence references do not make an otherwise matching semantic assertion false.",
    "one_to_one": "Each expected semantic assertion can pair with at most one candidate assertion; duplicate candidate assertions are false positives.",
    "numeric_and_date_values": "Use the deterministic normalization rules above before comparison."
  },
  "scoring_boundary": "Canonicalize public subject/predicate/value fields deterministically. Never use expected values to create candidate aliases and never use an LLM judge. The candidate must not emit evaluator-internal state_key values."
}

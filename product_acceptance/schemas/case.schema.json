{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackhole.local/product-v2-dogfood/case.schema.json",
  "title": "Blackhole Product V2 dogfood acceptance case collection",
  "description": "User-visible, black-box acceptance cases. This is a development acceptance suite, not hidden benchmark ground truth.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/case"
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with an explicit UTC offset."
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "mime_type"],
      "properties": {
        "fixture": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "saved": {"type": "boolean"},
        "durable": {"type": "boolean"},
        "processing": {"type": "string", "enum": ["pending", "processed", "failed", "fresh", "retryable"]},
        "message": {"type": "string"},
        "include": {"type": "array", "items": {"type": "string"}},
        "exclude": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "string", "enum": ["required", "not_required", "if_available"]},
        "uncertainty": {"type": "string", "enum": ["required", "not_required", "if_relevant"]},
        "actionable": {"type": "boolean"},
        "not_urgent": {"type": "boolean"},
        "empty": {"type": "boolean"},
        "outcome": {"type": "string", "enum": ["processed", "failed", "retryable", "fresh", "no_duplicate"]},
        "removed_from_active": {"type": "array", "items": {"type": "string"}},
        "raw_preserved": {"type": "boolean"},
        "state_preserved": {"type": "boolean"},
        "attachment_persisted": {"type": "boolean"},
        "duplicate": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "type": {"type": "string", "enum": ["capture", "advance_time", "ask", "attention", "memory", "undo", "process", "retry", "restart", "set_provider", "health"]},
        "capture_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "target_capture_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "at": {"$ref": "#/$defs/timestamp"},
        "to": {"$ref": "#/$defs/timestamp"},
        "text": {"type": "string", "minLength": 1},
        "attachment": {"$ref": "#/$defs/attachment"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "availability": {"type": "string", "enum": ["available", "unavailable", "fail_once"]},
        "expect": {"$ref": "#/$defs/expectation"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "title", "locale", "tags", "initial_time", "timezone", "user_outcome", "steps"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
        "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "initial_time": {"$ref": "#/$defs/timestamp"},
        "timezone": {"type": "string", "pattern": "^[A-Za-z]+(?:/[A-Za-z0-9_.+-]+)+$"},
        "user_outcome": {"type": "string", "minLength": 1},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "manual_observations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

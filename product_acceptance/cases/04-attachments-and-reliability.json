    "steps": [
      {"id": "provider-fails-once", "type": "set_provider", "availability": "fail_once"},
      {"id": "capture-garden", "type": "capture", "at": "2026-05-06T09:00:00+01:00", "text": "The herb planter needs a sunnier spot.", "idempotency_key": "rel-006-garden", "expect": {"saved": true, "processing": "pending"}},

    "timezone": "America/New_York",
    "user_outcome": "Uploading the same image twice preserves both source events if needed, but active memory does not double-count the same visual evidence.",
    "steps": [
      {"id": "capture-first-image", "type": "capture", "at": "2026-05-05T09:00:00-04:00", "attachment": {"fixture": "blue-suitcase.svg", "mime_type": "image/svg+xml", "filename": "suitcase.svg"}, "idempotency_key": "att-005-first", "expect": {"saved": true, "processing": "pending", "attachment_persisted": true}},

      {"id": "ask-garden", "type": "ask", "at": "2026-05-06T09:04:00+01:00", "question": "What did I note about the herb planter?", "expect": {"include": ["sunnier spot"], "evidence": "required"}}
    ],
    "manual_observations": ["No retry should require the user to retype the original note."]
